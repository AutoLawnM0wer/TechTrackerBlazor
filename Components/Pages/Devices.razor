@page "/Devices"
@using TechTrackerBlazor.Models
@using TechTrackerBlazor.Services
@inject TechTrackerHell DbService
@inject IJSRuntime JS
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>TechTracker - Devices</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Device Directory</h3>
    <button class="btn btn-primary" @onclick="ToggleAddForm">
        <span class="bi bi-phone" aria-hidden="true"></span> @(showAddForm ? "Cancel" : "Add Device")
    </button>
</div>

@if (showAddForm)
{
    <div class="card p-3 mb-4 shadow-sm border-primary">
        <h5>Register New Device</h5>
        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label text-muted small mb-0">Owner (Customer)</label>
                <select @bind="newDevice.CustomerId" class="form-select">
                    <option value="">-- Select Customer --</option>
                    @if (customerList != null)
                    {
                        @foreach (Customer cust in customerList)
                        {
                            <option value="@cust.Id">@cust.FirstName @cust.LastName</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label text-muted small mb-0">Type</label>
                <select @bind="newDevice.DeviceType" class="form-select">
                    <option value="Smartphone">Smartphone</option>
                    <option value="Tablet">Tablet</option>
                    <option value="Laptop">Laptop</option>
                    <option value="Desktop">Desktop</option>
                    <option value="Console">Console</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label text-muted small mb-0">Brand</label>
                <input @bind="newDevice.Brand" class="form-control" placeholder="e.g. Apple" />
            </div>
            <div class="col-md-3">
                <label class="form-label text-muted small mb-0">Model</label>
                <input @bind="newDevice.Model" class="form-control" placeholder="e.g. iPhone 13 Pro" />
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button class="btn btn-success w-100" @onclick="AddDevice">Save Device</button>
            </div>
        </div>
        <div class="row g-3 mt-1">
            <div class="col-md-4">
                <label class="form-label text-muted small mb-0">Serial Number / IMEI</label>
                <input @bind="newDevice.SerialNumber" class="form-control" placeholder="Optional..." />
            </div>
            <div class="col-md-8">
                <label class="form-label text-muted small mb-0">Condition Notes (Scratches, dents, etc.)</label>
                <input @bind="newDevice.ConditionNotes" class="form-control" placeholder="Pre-existing damage..." />
            </div>
        </div>
    </div>
}

@if (isEditing && editingDevice != null)
{
    <div class="card p-3 mb-4 border-info shadow">
        <h5>Editing Device: @editingDevice.Brand @editingDevice.Model</h5>
        <div class="row g-2 mb-2">
            <div class="col-md-3">
                <label class="form-label text-muted small mb-0">Type</label>
                <select @bind="editingDevice.DeviceType" class="form-select">
                    <option value="Smartphone">Smartphone</option>
                    <option value="Tablet">Tablet</option>
                    <option value="Laptop">Laptop</option>
                    <option value="Desktop">Desktop</option>
                    <option value="Console">Console</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label text-muted small mb-0">Brand & Model</label>
                <div class="input-group">
                    <input @bind="editingDevice.Brand" class="form-control" />
                    <input @bind="editingDevice.Model" class="form-control" />
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label text-muted small mb-0">Serial Number</label>
                <input @bind="editingDevice.SerialNumber" class="form-control" />
            </div>
            <div class="col-md-3">
                <label class="form-label text-muted small mb-0">Condition Notes</label>
                <input @bind="editingDevice.ConditionNotes" class="form-control" />
            </div>
        </div>
        <div class="row g-2">
             <div class="col-md-8">
                <label class="form-label text-muted small mb-0">Transfer Ownership (Customer)</label>
                <select @bind="editingDevice.CustomerId" class="form-select">
                    @if (customerList != null)
                    {
                        @foreach (Customer cust in customerList)
                        {
                            <option value="@cust.Id">@cust.FirstName @cust.LastName</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-4 d-flex align-items-end justify-content-end">
                <button class="btn btn-primary w-50 me-2" @onclick="SaveUpdate">Update</button>
                <button class="btn btn-secondary w-50" @onclick="() => isEditing = false">Cancel</button>
            </div>
        </div>
    </div>
}

@if (deviceList == null)
{
    <div class="alert alert-info"><em>Loading devices from MongoDB...</em></div>
}
else if (deviceList.Count == 0)
{
    <div class="alert alert-warning"><em>No devices found in the database.</em></div>
}
else
{
    <div class="table-responsive shadow-sm border rounded">
        <table class="table table-striped table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Type</th>
                    <th>Owner</th> <th>Device</th>
                    <th>Serial/IMEI</th>
                    <th>Registered</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (DeviceAsset device in deviceList)
                {
                    <tr>
                        <td>
                            <span class="badge bg-secondary">@device.DeviceType</span>
                        </td>
                        <td>
                            @if (customerList != null)
                            {
                                Customer? owner = customerList.FirstOrDefault(c => c.Id == device.CustomerId);
                                if (owner != null)
                                {
                                    <span><strong>@owner.LastName</strong>, @owner.FirstName</span>
                                }
                                else
                                {
                                    <span class="text-muted small"><em>Unassigned</em></span>
                                }
                            }
                        </td>
                        <td><strong>@device.Brand</strong> @device.Model</td>
                        <td><small class="text-muted">@device.SerialNumber</small></td>
                        <td>@device.DateAdded.ToShortDateString()</td>
                        <td class="text-end">
                            <div class="btn-group">
                                <button class="btn btn-sm btn-outline-info" @onclick="() => StartEdit(device)">Manage</button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteDevice(device.Id)">Delete</button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<DeviceAsset>? deviceList;
    private List<Customer>? customerList;
    
    private DeviceAsset newDevice = new DeviceAsset();
    private DeviceAsset? editingDevice;
    private bool showAddForm = false;
    private bool isEditing = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        deviceList = await DbService.GetAllDevicesAsync();
        customerList = await DbService.GetAllCustomersAsync(); 
    }

    private void ToggleAddForm() => showAddForm = !showAddForm;

    private async Task AddDevice()
    {
        if (!string.IsNullOrWhiteSpace(newDevice.Brand) && !string.IsNullOrWhiteSpace(newDevice.CustomerId))
        {
            await DbService.CreateDeviceAsync(newDevice);
            newDevice = new DeviceAsset(); 
            showAddForm = false;
            await LoadData();
        }
    }

    private async Task StartEdit(DeviceAsset device)
    {
        await JS.InvokeVoidAsync(identifier: "window.scrollTo", 0, 0);

        editingDevice = new DeviceAsset
        {
            Id = device.Id,
            CustomerId = device.CustomerId,
            DeviceType = device.DeviceType,
            Brand = device.Brand,
            Model = device.Model,
            SerialNumber = device.SerialNumber,
            ConditionNotes = device.ConditionNotes,
            DateAdded = device.DateAdded
        };
        isEditing = true;
    }

    private async Task SaveUpdate()
    {
        if (editingDevice != null)
        {
            await DbService.UpdateDeviceAsync(editingDevice);
            isEditing = false;
            await LoadData();
        }
    }

    private async Task DeleteDevice(string? id)
    {
        if (!string.IsNullOrEmpty(id))
        {
            bool isConfirmed = await JS.InvokeAsync<bool>(identifier: "window.confirm", "Are you sure you want to delete this device?");
            
            if (isConfirmed)
            {
                await DbService.DeleteDeviceAsync(id);
                await JS.InvokeVoidAsync(identifier: "window.scrollTo", 0, 0); 
                await LoadData();
            }
        }
    }
}
