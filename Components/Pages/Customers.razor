@page "/customers"
@using TechTrackerBlazor.Models
@using TechTrackerBlazor.Services
@inject MongoDbService DbService

<PageTitle>TechTracker - Customers</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Customer Directory</h3>
    <button class="btn btn-primary">
        <span class="bi bi-person-plus" aria-hidden="true"></span> Add Customer
    </button>
</div>

@if (customerList == null)
{
    <div class="alert alert-info">
        <em>Loading database records from MongoDB...</em>
    </div>
}
else if (customerList.Count == 0)
{
    <div class="alert alert-warning">
        <em>No customers found in the database.</em>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>First Name</th>
                    <th>Last Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Account Created</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var customer in customerList)
                {
                    <tr>
                        <td>@customer.FirstName</td>
                        <td>@customer.LastName</td>
                        <td>
                            @if (!string.IsNullOrEmpty(customer.Email))
                            {
                                <a href="mailto:@customer.Email">@customer.Email</a>
                            }
                        </td>
                        <td>@customer.Phone</td>
                        <td>@customer.CreationDate.ToShortDateString()</td>
                        <td>
                            <button class="btn btn-sm btn-outline-info">View Details</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<Customer>? customerList;

    protected override async Task OnInitializedAsync()
    {
        customerList = await DbService.GetAllCustomersAsync();
    }
}
