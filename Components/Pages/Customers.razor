@page "/customers"
@using MongoDB.Bson
@using TechTrackerBlazor.Services
@inject TechTrackerHell DbService

<PageTitle>TechTracker - Customers</PageTitle>

<h3 class="mb-3">Customer Directory</h3>

<CollectionTable CollectionName="Customers" Documents="customerList" />

@code {
    private List<BsonDocument>? customerList;

    protected override async Task OnInitializedAsync()
    {
        customerList = await DbService.GetCollectionDocumentsAsync("Customers");
    }
}
