@page "/customers"
@using TechTrackerBlazor.Models
@using TechTrackerBlazor.Services
@inject TechTrackerHell DbService
@inject IJSRuntime JS
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>TechTracker - Customers</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Customer Directory</h3>
    <button class="btn btn-primary" @onclick="ToggleAddForm">
        <span class="bi bi-person-plus" aria-hidden="true"></span> @(showAddForm ? "Cancel" : "Add Customer")
    </button>
</div>

@if (showAddForm)
{
    <div class="card p-3 mb-4 shadow-sm border-primary">
        <h5>New Customer Entry</h5>
        <div class="row g-3">
            <div class="col-md-2">
                <input @bind="newCust.FirstName" class="form-control" placeholder="First Name" />
            </div>
            <div class="col-md-2">
                <input @bind="newCust.LastName" class="form-control" placeholder="Last Name" />
            </div>
            <div class="col-md-3">
                <input @bind="newCust.Email" class="form-control" placeholder="Email Address" />
            </div>
            <div class="col-md-3">
                <input @bind="newCust.Phone" class="form-control" placeholder="Phone (e.g. 123-456-7890)" />
            </div>
            <div class="col-md-2">
                <button class="btn btn-success w-100" @onclick="AddCustomer">Save</button>
            </div>
        </div>
    </div>
}

@if (isEditing && editingCust != null)
{
    <div class="card p-3 mb-4 border-info shadow">
        <h5>Editing: @editingCust.FirstName @editingCust.LastName</h5>
        <div class="row g-2">
            <div class="col"><input @bind="editingCust.FirstName" class="form-control" /></div>
            <div class="col"><input @bind="editingCust.LastName" class="form-control" /></div>
            <div class="col"><input @bind="editingCust.Email" class="form-control" /></div>
            <div class="col"><input @bind="editingCust.Phone" class="form-control" /></div>
            <div class="col-auto">
                <button class="btn btn-primary" @onclick="SaveUpdate">Update</button>
                <button class="btn btn-secondary" @onclick="() => isEditing = false">Cancel</button>
            </div>
        </div>
    </div>
} 

@if (customerList == null)
{
    <div class="alert alert-info">
        <em>Loading database records from MongoDB...</em>
    </div>
}
else if (customerList.Count == 0)
{
    <div class="alert alert-warning">
        <em>No customers found in the database.</em>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>First Name</th>
                    <th>Last Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Account Created</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var customer in customerList)
                {
                    <tr>
                        <td>@customer.FirstName</td>
                        <td>@customer.LastName</td>
                        <td>
                            @if (!string.IsNullOrEmpty(customer.Email))
                            {
                                <a href="mailto:@customer.Email">@customer.Email</a>
                            }
                        </td>
                        <td>@customer.Phone</td>
                        <td>@customer.CreationDate.ToShortDateString()</td>
                        <td>
                            <div class="btn-group">
                                <button class="btn btn-sm btn-outline-info" @onclick="() => StartEdit(customer)">Details</button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteCustomer(customer.Id)">Delete</button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<Customer>? customerList;
    private Customer newCust = new Customer();
    private bool showAddForm = false;
    private Customer? editingCust;
    private bool isEditing = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadCustomers();
    }

    private async Task LoadCustomers()
    {
        customerList = await DbService.GetAllCustomersAsync();
    }

    private void ToggleAddForm() => showAddForm = !showAddForm;

    private async Task AddCustomer()
    {
        if (!string.IsNullOrWhiteSpace(newCust.LastName))
        {
            newCust.CreationDate = DateTime.Now; 
            await DbService.CreateCustomerAsync(newCust);
            newCust = new Customer();
            showAddForm = false;
            await LoadCustomers();
        }
    }

    private async Task DeleteCustomer(string? id)
    {
        if (!string.IsNullOrEmpty(id))
        {
            bool isConfirmed = await JS.InvokeAsync<bool>(identifier: "window.confirm", "Are you sure you want to delete this customer profile? This action cannot be undone.");

            if (isConfirmed)
            {
                await DbService.DeleteCustomerAsync(id);
                await JS.InvokeVoidAsync(identifier: "window.scrollTo", 0, 0);
                await LoadCustomers();
            }
        }
    }

    private async Task StartEdit(Customer customer)
    {
        await JS.InvokeVoidAsync(identifier: "window.scrollTo", 0, 0);

        editingCust = new Customer 
        { 
            Id = customer.Id, 
            FirstName = customer.FirstName, 
            LastName = customer.LastName, 
            Email = customer.Email,
            Phone = customer.Phone,
            CreationDate = customer.CreationDate
        };
        isEditing = true;
    }
    private async Task SaveUpdate()
    {
        if (editingCust != null)
        {
            await DbService.UpdateCustomerAsync(editingCust);
            isEditing = false;
            await LoadCustomers(); 
        }
    }
}
