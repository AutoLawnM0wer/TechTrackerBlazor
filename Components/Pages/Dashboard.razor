@page "/"
@using ChartJs.Blazor
@using ChartJs.Blazor.Common
@using ChartJs.Blazor.Common.Axes
@using ChartJs.Blazor.Common.Axes.Ticks
@using ChartJs.Blazor.Common.Enums
@using ChartJs.Blazor.BarChart
@using TechTrackerBlazor.Services
@using TechTrackerBlazor.Models
@inject TechTrackerHell DbService
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>TechTracker - Business Dashboard</PageTitle>

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-12">
            <h2>Business Analytical Dashboard</h2>
            <p class="text-muted">Real-time repair operations and revenue trends.</p>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card shadow-sm border-0 bg-primary text-white p-3">
                <div class="card-body">
                    <h6 class="card-title text-uppercase">Total Monthly Revenue</h6>
                    <h2 class="display-6">@currentMonthRevenue.ToString("C")</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-0 bg-success text-white p-3">
                <div class="card-body">
                    <h6 class="card-title text-uppercase">Avg. Turnaround Time</h6>
                    <h2 class="display-6">@avgTurnaroundDays Days</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-0 bg-info text-white p-3">
                <div class="card-body">
                    <h6 class="card-title text-uppercase">Active Repairs</h6>
                    <h2 class="display-6">@activeRepairCount</h2>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card shadow-sm border-0 p-4">
                <h5 class="mb-3">Most Frequent Repair Types (by Status)</h5>
                @if (_barConfig == null)
                {
                    <p><em>Loading Chart...</em></p>
                }
                else
                {
                    <Chart Config="_barConfig"></Chart>
                }
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-0 p-4 h-100">
                <h5>Dashboard Summary</h5>
                <ul class="list-group list-group-flush mt-3">
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        Revenue Trend
                        <span class="badge bg-primary rounded-pill">Stable</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        High Priority Tickets
                        <span class="badge bg-danger rounded-pill">3</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

@code {
    private decimal currentMonthRevenue;
    private double avgTurnaroundDays;
    private int activeRepairCount;
    private BarConfig? _barConfig;

    protected override async Task OnInitializedAsync()
    {
        Dictionary<string, decimal>? revenueData = await DbService.GetMonthlyRevenueAsync();
        currentMonthRevenue = revenueData.Values.LastOrDefault(); 

        avgTurnaroundDays = await DbService.GetAverageTurnaroundTimeAsync(); 

        Dictionary<string, int>? repairStats = await DbService.GetRepairTypeStatsAsync(); 
        
        repairStats.TryGetValue(key: "In Progress", out activeRepairCount);
        
        int maxRepairs = repairStats.Values.Any() ? repairStats.Values.Max() : 10;

        _barConfig = new BarConfig
        {
            Options = new BarOptions
            {
                Responsive = true,
                Legend = new Legend { Display = false },
                Title = new OptionsTitle { Display = false },
                Scales = new BarScales
                {
                    YAxes = new List<CartesianAxis>
                    {
                        new LinearCartesianAxis
                        {
                            Ticks = new LinearCartesianTicks
                            {
                                BeginAtZero = true,
                                SuggestedMax = maxRepairs + 2
                            }
                        }
                    }
                }
            }
        };

        foreach (string key in repairStats.Keys)
        {
            _barConfig.Data.Labels.Add(key);
        }

        IDataset<int> dataset = new BarDataset<int>(repairStats.Values)
        {
            BackgroundColor = new[] { "#ffc107", "#198754", "#0d6efd", "#dc3545", "#6c757d" }
        };

        _barConfig.Data.Datasets.Add(dataset);
    }
}
