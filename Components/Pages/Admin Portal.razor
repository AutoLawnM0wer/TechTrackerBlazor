@page "/AdminPortal"
@using TechTrackerBlazor.Models
@using TechTrackerBlazor.Services
@inject TechTrackerHell DbService
@inject IJSRuntime JS
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>TechTracker - Admin Portal</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Admin Portal</h3>
    <button class="btn btn-primary" @onclick="ToggleAddForm">
        <span class="bi bi-person-badge" aria-hidden="true"></span> @(showAddForm ? "Cancel" : "Add Employee")
    </button>
</div>

@if (showAddForm)
{
    <div class="card p-3 mb-4 shadow-sm border-primary">
        <h5>New Employee Onboarding</h5>
        <div class="row g-2 mb-2">
            <div class="col-md-3"><input @bind="newEmp.FirstName" class="form-control" placeholder="First Name" /></div>
            <div class="col-md-3"><input @bind="newEmp.LastName" class="form-control" placeholder="Last Name" /></div>
            <div class="col-md-3">
                <select @bind="newEmp.EmployeeRole" class="form-select">
                    <option value="Manager">Manager</option>
                    <option value="Technician">Technician</option>
                    <option value="Customer Service">Customer Service</option>
                </select>
            </div>
            <div class="col-md-3"><input @bind="newEmp.PasswordHash" class="form-control" placeholder="Temporary Password" /></div>
        </div>
        <div class="row g-2 mb-2">
            <div class="col-md-4"><input @bind="newEmp.Email" class="form-control" placeholder="Email Address" /></div>
            <div class="col-md-3"><input @bind="newEmp.PhoneNumber" class="form-control" placeholder="Phone Number" /></div>
            <div class="col-md-5 d-flex align-items-center">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" role="switch" @bind="newEmp.isAvailable" id="activeSwitch">
                    <label class="form-check-label" for="activeSwitch">Currently Active/Available</label>
                </div>
            </div>
        </div>
        <div class="row g-2">
            <div class="col-md-4"><input @bind="newEmp.EmployeeAddress.Street" class="form-control" placeholder="Street Address" /></div>
            <div class="col-md-3"><input @bind="newEmp.EmployeeAddress.City" class="form-control" placeholder="City" /></div>
            <div class="col-md-1"><input @bind="newEmp.EmployeeAddress.State" class="form-control" placeholder="State" /></div>
            <div class="col-md-2"><input @bind="newEmp.EmployeeAddress.ZipCode" class="form-control" placeholder="Zip" /></div>
            <div class="col-md-2">
                <button class="btn btn-success w-100" @onclick="AddEmployee">Save Profile</button>
            </div>
        </div>
    </div>
}

@if (isEditing && editingEmp != null)
{
    <div class="card p-3 mb-4 border-warning shadow">
        <h5>Editing: @editingEmp.FirstName @editingEmp.LastName</h5>
        <div class="row g-2 mb-2">
            <div class="col-md-3"><input @bind="editingEmp.FirstName" class="form-control" /></div>
            <div class="col-md-3"><input @bind="editingEmp.LastName" class="form-control" /></div>
            <div class="col-md-3">
                <select @bind="editingEmp.EmployeeRole" class="form-select">
                    <option value="Manager">Manager</option>
                    <option value="Technician">Technician</option>
                    <option value="Customer Service">Customer Service</option>
                </select>
            </div>
            <div class="col-md-3"><input @bind="editingEmp.PasswordHash" class="form-control" placeholder="Update Password" /></div>
        </div>
        <div class="row g-2 mb-2">
            <div class="col-md-4"><input @bind="editingEmp.Email" class="form-control" /></div>
            <div class="col-md-3"><input @bind="editingEmp.PhoneNumber" class="form-control" /></div>
             <div class="col-md-5 d-flex align-items-center">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" role="switch" @bind="editingEmp.isAvailable" id="editActiveSwitch">
                    <label class="form-check-label" for="editActiveSwitch">Currently Active/Available</label>
                </div>
            </div>
        </div>
        <div class="row g-2">
            <div class="col-md-4"><input @bind="editingEmp.EmployeeAddress.Street" class="form-control" /></div>
            <div class="col-md-3"><input @bind="editingEmp.EmployeeAddress.City" class="form-control" /></div>
            <div class="col-md-1"><input @bind="editingEmp.EmployeeAddress.State" class="form-control" /></div>
            <div class="col-md-2"><input @bind="editingEmp.EmployeeAddress.ZipCode" class="form-control" /></div>
            <div class="col-md-2 d-flex">
                <button class="btn btn-primary w-100 me-1" @onclick="SaveUpdate">Update</button>
                <button class="btn btn-secondary w-100" @onclick="() => isEditing = false">Cancel</button>
            </div>
        </div>
    </div>
} 

@if (employeeList == null)
{
    <div class="alert alert-info"><em>Loading staff records from MongoDB...</em></div>
}
else if (employeeList.Count == 0)
{
    <div class="alert alert-warning"><em>No employees found in the database.</em></div>
}
else
{
    <div class="table-responsive shadow-sm border rounded">
        <table class="table table-striped table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Status</th>
                    <th>Name</th>
                    <th>Role</th>
                    <th>Contact</th>
                    <th>Location</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (Employee emp in employeeList)
                {
                    <tr>
                        <td>
                            @if(emp.isAvailable)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>
                        <td><strong>@emp.FirstName @emp.LastName</strong></td>
                        <td>
                            <span class="badge @(emp.EmployeeRole == "Manager" ? "bg-primary" : emp.EmployeeRole == "Technician" ? "bg-info text-dark" : "bg-secondary")">
                                @emp.EmployeeRole
                            </span>
                        </td>
                        <td>
                            <div class="small">
                                <div><i class="bi bi-envelope"></i> @emp.Email</div>
                                <div><i class="bi bi-telephone"></i> @emp.PhoneNumber</div>
                            </div>
                        </td>
                        <td>
                            <div class="small text-muted">
                                @emp.EmployeeAddress.City, @emp.EmployeeAddress.State
                            </div>
                        </td>
                        <td class="text-end">
                            <div class="btn-group">
                                <button class="btn btn-sm btn-outline-info" @onclick="() => StartEdit(emp)">Manage</button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteEmployee(emp.Id)">Remove</button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<Employee>? employeeList;
    private Employee newEmp = new Employee();
    private Employee? editingEmp;
    private bool showAddForm = false;
    private bool isEditing = false;
    protected override async Task OnInitializedAsync()
    {
        await LoadEmployees();
    }
    private async Task LoadEmployees()
    {
        employeeList = await DbService.GetAllEmployeesAsync();
    }
    private void ToggleAddForm() => showAddForm = !showAddForm;
    private async Task AddEmployee()
    {
        if (!string.IsNullOrWhiteSpace(newEmp.LastName))
        {
            await DbService.CreateEmployeeAsync(newEmp);
            newEmp = new Employee(); 
            showAddForm = false;
            await LoadEmployees();
        }
    }
    private async Task StartEdit(Employee emp)
    {
        await JS.InvokeVoidAsync(identifier: "window.scrollTo", 0, 0);
        editingEmp = new Employee 
        { 
            Id = emp.Id, 
            FirstName = emp.FirstName, 
            LastName = emp.LastName, 
            Email = emp.Email,
            PhoneNumber = emp.PhoneNumber,
            PasswordHash = emp.PasswordHash,
            EmployeeRole = emp.EmployeeRole,
            isAvailable = emp.isAvailable,
            EmployeeAddress = new Address 
            {
                Street = emp.EmployeeAddress?.Street,
                City = emp.EmployeeAddress?.City,
                State = emp.EmployeeAddress?.State,
                ZipCode = emp.EmployeeAddress?.ZipCode
            }
        };
        isEditing = true;
    }
    private async Task SaveUpdate()
    {
        if (editingEmp != null)
        {
            await DbService.UpdateEmployeeAsync(editingEmp);
            isEditing = false;
            await LoadEmployees(); 
        }
    }
    private async Task DeleteEmployee(string? id)
    {
        if (!string.IsNullOrEmpty(id))
        {
            bool isConfirmed = await JS.InvokeAsync<bool>(identifier: "window.confirm", "Are you sure you want to completely remove this employee? This action cannot be undone.");

            if (isConfirmed)
            {
                await DbService.DeleteEmployeeAsync(id);
                await JS.InvokeVoidAsync(identifier: "window.scrollTo", 0, 0);
                await LoadEmployees();
            }
        }
    }
}
